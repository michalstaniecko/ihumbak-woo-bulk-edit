{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "./assets/build",
    "rootDir": "./assets/js",
    "baseUrl": "./assets/js",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["assets/js/**/*.ts", "assets/js/**/*.tsx"],
  "exclude": ["node_modules", "assets/build"]
}
