{
    "name": "ihumbak/woo-bulk-edit",
    "description": "WooCommerce Bulk Edit plugin with preview & commit UX, SQL-like filtering, and audit log.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "^6.4",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "IhumbakWooBulkEdit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IhumbakWooBulkEdit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration --bootstrap tests/Integration/bootstrap.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
